# Override auto-generated Release/makefile link rule so --gc-sections / LDFLAGS_APP_OPTIMIZATIONS apply.
# Mobo_config.c is built via Release/src/subdir.mk (same -I/-D as other sources).
widget.elf: $(OBJS) $(USER_OBJS)
	@echo Link $@ $(LDFLAGS_APP_OPTIMIZATIONS)
	@avr32-gcc -nostartfiles -Wl,-e,_trampoline $(ASFLAGS) \
		-Wl,--gc-sections --rodata-writable -Wl,--direct-data \
		$(LDFLAGS_APP_OPTIMIZATIONS) -o"widget.elf" $(OBJS) $(USER_OBJS) $(LIBS)
